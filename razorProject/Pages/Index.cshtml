@page
@using System.Text.Json
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="row">
    <!-- Input Form -->
    <div class="col-md-6">
        <h3>Class Information</h3>
        <form method="post" class="card p-3">
            <input type="hidden" asp-for="NewClass.Id" />
            <input type="hidden" asp-for="ClassTable.CurrentPage" />
            <input type="hidden" asp-for="ClassTable.PageSize" />
            <input type="hidden" asp-for="ClassTable.ClassNameFilter" />
            <input type="hidden" asp-for="ClassTable.StudentCountFilter" />

            <div class="form-group mb-3">
                <label asp-for="NewClass.ClassName"></label>
                <input asp-for="NewClass.ClassName" class="form-control" />
                <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NewClass.StudentCount"></label>
                <input type="number" asp-for="NewClass.StudentCount" class="form-control" />
                <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NewClass.Description"></label>
                <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                <span asp-validation-for="NewClass.Description" class="text-danger"></span>
            </div>

            <button type="submit" class="btn @(Model.NewClass.Id == 0 ? "btn-primary" : "btn-success")">
                @(Model.NewClass.Id == 0 ? "Add Class" : "Update Class")
            </button>
        </form>
    </div>
    <div class="col-md-6">
        <h3>Class List</h3>
        <form method="get" class="mb-3">
            <div class="row g-3">
                <div class="col">
                    <input type="text" name="classNameFilter" class="form-control" 
                           placeholder="Class Name" value="@Model.ClassTable.ClassNameFilter" />
                </div>
                <div class="col">
                    <input type="number" name="studentCountFilter" class="form-control" 
                           placeholder="Student Count" value="@Model.ClassTable.StudentCountFilter" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Filter</button>
                </div>
            </div>
        </form>

        <!-- Add this ABOVE the table -->
    <div class="mb-3">
        <form method="post">
            <div class="btn-group mb-2">
                <button type="submit" asp-page-handler="ExportAll" class="btn btn-outline-primary">
                    Export All as JSON
                </button>
                <button type="submit" asp-page-handler="ExportFiltered" class="btn btn-outline-secondary">
                    Export Filtered as JSON
                </button>
            </div>

            <!-- Column Selection Checkboxes -->
            <!-- Change checkbox initialization to use proper JSON parsing -->
            
            <div class="form-check form-check-inline">
                <input class="form-check-input column-checkbox" type="checkbox" value="ClassName" 
                    id="colClassName" @(Model.SelectedColumns.Contains("ClassName") ? "checked" : "")>
                <label class="form-check-label" for="colClassName">Class Name</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input column-checkbox" type="checkbox" value="StudentCount" 
                    id="colStudentCount" @(Model.SelectedColumns.Contains("StudentCount") ? "checked" : "")>
                <label class="form-check-label" for="colStudentCount">Students</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input column-checkbox" type="checkbox" value="Description" 
                    id="colDescription" @(Model.SelectedColumns.Contains("Description") ? "checked" : "")>
                <label class="form-check-label" for="colDescription">Description</label>
            </div>

            <input type="hidden" asp-for="SelectedColumnsJson" id="selectedColumns" />
        </form>
    </div>

        <!-- Class Table -->
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Class Name</th>
                    <th>Students</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ClassTable.Classes)
                {
                    <tr>
                        <td>@item.ClassName</td>
                        <td>@item.StudentCount</td>
                        <td>@item.Description</td>
                        <td>
                            <a asp-page="./Index" 
                               asp-route-editId="@item.Id"
                               asp-route-pageNumber="@Model.ClassTable.CurrentPage"
                               asp-route-pageSize="@Model.ClassTable.PageSize"
                               asp-route-classNameFilter="@Model.ClassTable.ClassNameFilter"
                               asp-route-studentCountFilter="@Model.ClassTable.StudentCountFilter"
                               class="btn btn-sm btn-warning">Edit</a>
                            
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="pageNumber" value="@Model.ClassTable.CurrentPage" />
                                <input type="hidden" name="pageSize" value="@Model.ClassTable.PageSize" />
                                <input type="hidden" name="classNameFilter" value="@Model.ClassTable.ClassNameFilter" />
                                <input type="hidden" name="studentCountFilter" value="@Model.ClassTable.StudentCountFilter" />
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- pagination  (pagination structure created with thead assistance of DeepSeekLLM)-->
        <nav>
            <ul class="pagination">
                @for (int i = 1; i <= Model.ClassTable.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.ClassTable.CurrentPage ? "active" : "")">
                        <a class="page-link" 
                           href="?pageNumber=@i&pageSize=@Model.ClassTable.PageSize&classNameFilter=@Model.ClassTable.ClassNameFilter&studentCountFilter=@Model.ClassTable.StudentCountFilter">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
    // Add this to auto-submit when checkboxes change
    document.querySelectorAll('.column-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', () => {
            updateSelectedColumns();
            document.querySelector('form').submit(); // Submit the parent form
        });
    });
    </script>

    <script>
        function updateSelectedColumns() {
            const selected = Array.from(document.querySelectorAll('.column-checkbox:checked'))
                .map(checkbox => checkbox.value);
            
            // Validate against allowed columns
            const allowedColumns = ["ClassName", "StudentCount", "Description"];
            const filtered = selected.filter(c => allowedColumns.includes(c));
            
            document.getElementById('selectedColumns').value = JSON.stringify(filtered);
        }

        // Add event listeners to checkboxes
        document.querySelectorAll('.column-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', updateSelectedColumns);
        });

        // Initial update in case of page reload
        updateSelectedColumns();
    </script>
}